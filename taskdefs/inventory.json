{
  "family": "jy-project-inventory",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "${ECS_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${ECS_TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "inventory",
      "image": "263232886346.dkr.ecr.ap-northeast-2.amazonaws.com/jy-project/inventory:PLACEHOLDER",
      "cpu": 128,
      "memory": 256,
      "essential": true,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp", "appProtocol": "http", "name": "inventory-8000" }
      ],
      "environment": [
        { "name": "ECS_FARGATE", "value": "true" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_NAME", "value": "inventory" },
        { "name": "DB_SSLMODE", "value": "verify-full" },
        { "name": "DD_SERVICE", "value": "inventory" },
        { "name": "DD_ENV", "value": "dev" },
        { "name": "DD_VERSION", "value": "0.0.1" },
        { "name": "DD_AGENT_HOST", "value": "localhost" },
        { "name": "DD_TRACE_AGENT_PORT", "value": "8126" }
      ],
      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:263232886346:parameter/jy-project/inventory-db-host"
        },
        {
          "name": "DB_USERNAME",
          "valueFrom": "${RDS_SECRET_ARN}:username::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "${RDS_SECRET_ARN}:password::"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "dependsOn": [
        { "containerName": "log-router", "condition": "START" }
      ],
      "logConfiguration": {
        "logDriver": "awsfirelens",
        "options": {
          "Name": "datadog",
          "Host": "http-intake.logs.${DD_SITE}",
          "TLS": "on",
          "provider": "ecs",
          "dd_service": "inventory",
          "dd_source": "python",
          "dd_tags": "env:dev"
        },
        "secretOptions": [
          { "name": "apikey", "valueFrom": "arn:aws:ssm:ap-northeast-2:263232886346:parameter/jy-project/datadog-api-key" }
        ]
      }
    },
    {
      "name": "datadog-agent",
      "image": "public.ecr.aws/datadog/agent:latest",
      "cpu": 256,
      "memory": 512,
      "essential": false,
      "environment": [
        { "name": "ECS_FARGATE", "value": "true" },
        { "name": "DD_APM_ENABLED", "value": "true" }
      ],
      "secrets": [
        { "name": "DD_API_KEY", "valueFrom": "arn:aws:ssm:ap-northeast-2:263232886346:parameter/jy-project/datadog-api-key" },
        { "name": "DD_SITE", "valueFrom": "arn:aws:ssm:ap-northeast-2:263232886346:parameter/jy-project/dd-site" }
      ]
    },
    {
      "name": "log-router",
      "image": "public.ecr.aws/aws-observability/aws-for-fluent-bit:stable",
      "cpu": 128,
      "memory": 256,
      "essential": true,
      "firelensConfiguration": {
        "type": "fluentbit",
        "options": {
          "enable-ecs-log-metadata": "true"
        }
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/jy-project-inventory-firelens",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "firelens",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
