{
  "family": "jy-project-inventory",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "${ECS_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${ECS_TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "inventory",
      "image": "263232886346.dkr.ecr.ap-northeast-2.amazonaws.com/jy-project/inventory:PLACEHOLDER",
      "cpu": 128,
      "memory": 256,
      "essential": true,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp", "appProtocol": "http", "name": "inventory-8000" }
      ],
      "environment": [
        { "name": "ECS_FARGATE", "value": "true" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_NAME", "value": "inventory" },
        { "name": "DB_SSLMODE", "value": "verify-full" }
      ],
      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:263232886346:parameter/jy-project/inventory-db-host"
        },
        {
          "name": "DB_USERNAME",
          "valueFrom": "${RDS_SECRET_ARN}:username::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "${RDS_SECRET_ARN}:password::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/jy-project-inventory",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "inventory",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "datadog-agent",
      "image": "public.ecr.aws/datadog/agent:latest",
      "cpu": 256,
      "memory": 512,
      "essential": false,
      "environment": [
        { "name": "ECS_FARGATE", "value": "true" },
        { "name": "DD_APM_ENABLED", "value": "false" }
      ],
      "secrets": [
        { "name": "DD_API_KEY", "valueFrom": "arn:aws:ssm:ap-northeast-2:263232886346:parameter/jy-project/datadog-api-key" },
        { "name": "DD_SITE", "valueFrom": "arn:aws:ssm:ap-northeast-2:263232886346:parameter/jy-project/dd-site" }
      ]
    }
  ]
}
