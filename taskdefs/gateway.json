{
  "family": "jy-project-gateway",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "${ECS_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${ECS_TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "gateway",
      "image": "263232886346.dkr.ecr.ap-northeast-2.amazonaws.com/jy-project/gateway:PLACEHOLDER",
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp", "appProtocol": "http", "name": "gateway-8000" }
      ],
      "environment": [
        { "name": "ECS_FARGATE", "value": "true" },
        { "name": "RESERVATION_URL", "value": "http://reservation.jy-project:8000" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/jy-project-gateway",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "gateway",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
