{
  "family": "jy-project-payment",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "${ECS_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${ECS_TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "payment",
      "image": "263232886346.dkr.ecr.ap-northeast-2.amazonaws.com/jy-project/payment:PLACEHOLDER",
      "cpu": 128,
      "memory": 256,
      "essential": true,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp", "appProtocol": "http", "name": "payment-8000" }
      ],
      "environment": [
        { "name": "ECS_FARGATE", "value": "true" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/jy-project-payment",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "payment",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "datadog-agent",
      "image": "public.ecr.aws/datadog/agent:latest",
      "cpu": 256,
      "memory": 512,
      "essential": false,
      "environment": [
        { "name": "ECS_FARGATE", "value": "true" },
        { "name": "DD_APM_ENABLED", "value": "false" }
      ],
      "secrets": [
        { "name": "DD_API_KEY", "valueFrom": "arn:aws:ssm:ap-northeast-2:263232886346:parameter/jy-project/datadog-api-key" },
        { "name": "DD_SITE", "valueFrom": "arn:aws:ssm:ap-northeast-2:263232886346:parameter/jy-project/dd-site" }
      ]
    }
  ]
}
